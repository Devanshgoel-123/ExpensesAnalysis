{
  "name": "upi-expense-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "POOLING_WORKER_PORT=5473 LOG_LEVEL=debug tsx watch src/worker/poolingServer.ts",
    "worker": "POOLING_WORKER_PORT=5473 LOG_LEVEL=debug tsx src/worker/poolingServer.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test tsx --test src/analytics/dailyInsights.test.ts src/analytics/fromStore.test.ts src/providers/registry.test.ts src/gmail/alertParser.test.ts src/rules/engine.test.ts && NODE_ENV=test tsx src/smoke-test.ts && NODE_ENV=test tsx src/product-test.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:down": "tsx src/db/migrate-cli.ts --down",
    "seed": "tsx src/db/seeds/demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}

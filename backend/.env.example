PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs in dev: LOG_PRETTY=1

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Postgres (recommended). Use `memory` only for local/tests.
DATABASE_URL=postgres://ledgerline:ledgerline@localhost:5432/ledgerline
# DATABASE_URL=memory

# Required secrets — generate strong values for anything beyond local demos:
#   openssl rand -hex 32   → JWT_SECRET (use as string)
#   openssl rand -hex 32   → ENCRYPTION_KEY (64 hex chars)
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

INVITE_CODES=beta-ledgerline,friend-invite

# Rate limiting (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=15

# Postgres pool
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Ephemeral parse without auth (dev only)
ALLOW_ANON_PARSE=0

# Optional Gmail OAuth (restricted scope — private beta test users only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
GMAIL_PUBSUB_TOPIC=
